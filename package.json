{
  "name": "kotonoha-meeting-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build && node scripts/build-pdf-assets.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:offline-browser": "node scripts/test-offline-browser.mjs",
    "check": "npm run build && npm test",
    "preview:qr-logos": "node scripts/check-qr-logo-ui.mjs",
    "test:qr-logo-browser": "node scripts/test-qr-logo-browser.mjs && node scripts/test-qr-logo-feature-browser.mjs && node scripts/test-qr-store-browser.mjs",
    "test:qr-caption-browser": "node scripts/test-qr-caption-browser.mjs && node scripts/test-qr-caption-ui-browser.mjs",
    "test:qr-logo-decoding": "node scripts/check-qr-logo-decoding.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@mediabunny/ac3": "1.59.0",
    "@supabase/supabase-js": "2.116.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsqr": "1.4.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.59.0",
    "multer": "^2.0.2",
    "openai": "^6.0.0",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "playwright": "1.64.1",
    "pngjs": "5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.0"
  }
}
